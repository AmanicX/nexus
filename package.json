{
  "name": "nexus",
  "private": true,
  "version": "1.2.0",
  "description": "Nexus — a multi-theme, memory-aware AI character chat studio for any OpenAI-compatible provider (Groq, OpenRouter, Ollama, LM Studio).",
  "author": "Nexus",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --base=./",
    "build:web": "tsc -b && vite build --base=./",
    "electron:dev": "node scripts/dev-electron.mjs",
    "dist": "npm run build:electron && electron-builder",
    "pack:win": "npm run build:electron && electron-builder --win",
    "pack:linux": "npm run build:electron && electron-builder --linux",
    "cap:sync": "npm run build:web && cap sync android",
    "cap:open": "cap open android",
    "android:apk": "npm run cap:sync && cd android && gradlew assembleDebug",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.nexus.chatstudio",
    "productName": "Nexus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "build/icon.png",
      "executableName": "nexus",
      "category": "Utility",
      "synopsis": "Multi-theme, memory-aware AI character chat studio",
      "description": "Nexus — a multi-theme, memory-aware AI character chat studio powered by Groq.",
      "maintainer": "Nexus <noreply@example.com>"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
